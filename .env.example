# ==========================================
# AZURE AI FOUNDRY / AZURE OPENAI CONFIG
# ==========================================
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
# Neural TTS deployment (gpt-4o-mini-tts in eastus2/swedencentral with 2025-03-01-preview, or tts-1)
# Note for Persona 1 (Infra): include AZURE_OPENAI_TTS_DEPLOYMENT in infra/main.bicep openAiEnv
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_OPENAI_TTS_API_VERSION=2025-03-01-preview
AZURE_OPENAI_TTS_TIMEOUT_S=7.0
# Optional: Azure AI Foundry Agent Service Project Endpoint
# AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-project.services.ai.azure.com/api/projects/default

# ==========================================
# BACKEND & FRONTEND NETWORKING
# ==========================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Frontend (read at runtime by the root layout; NEXT_PUBLIC_* still work for `npm run dev`)
API_URL=http://localhost:8000
WS_URL=ws://localhost:8000
LIVE_API_URL=http://localhost:8001
LIVE_WS_URL=ws://localhost:8001

# ==========================================
# LIVE MATCH (only ONE instance may run it: LIVE_ENABLED=false everywhere else)
# ==========================================
LIVE_ENABLED=true
LIVE_MATCH_DURATION_S=300
LIVE_CHALLENGE_WINDOW_S=30
LIVE_BOTS=200
