# PitchGhost-360 / xT-WhatIf Environment Variables Template

# -----------------------------------------------------------------------------
# Azure OpenAI Configuration (Agent Swarm)
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_REASONING=gpt-4o
AZURE_OPENAI_DEPLOYMENT_COACH=gpt-4o-mini

# -----------------------------------------------------------------------------
# Backend Settings (FastAPI)
# -----------------------------------------------------------------------------
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CACHE_DIR=app/data/cache

# -----------------------------------------------------------------------------
# Redis Configuration (Pub/Sub & Cache)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# StatsBomb Data Settings (Optional Open Data Credentials)
# -----------------------------------------------------------------------------
STATSBOMB_USER=
STATSBOMB_PASSWORD=
USE_STATSBOMB_OPEN_DATA=true

# -----------------------------------------------------------------------------
# Frontend Settings (Next.js 15)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
